  "compatibility": {
    "version": "evo-010-compat/v1",
    "keep_old_outputs": true,
    "negotiation": {
      "protocol": "awr.host capability discovery",
      "require_mechanism": [
        "capabilities --require",
        "MCP capability / schema negotiation"
      ],
      "new_fields_views_require_negotiation": [
        "response_view=action|summary",
        "query.coherent_snapshot",
        "workflow.prepare / workflow.response_summary / workflow.action_guidance",
        "assessment.explain"
      ],
      "failure_on_missing_required": [
        "CapabilityUnavailable",
        "ProtocolUnsupported"
      ],
      "forbidden": [
        "silent_degrade_when_required_capability_missing",
        "reinterpret_legacy_summary_blocked_count_as_action_blocked_count",
        "default_unknown_layer_status_to_success"
      ]
    },
    "legacy_consumers": {
      "status_full_view": "opt-in --view full / view:full",
      "status_summary_view": "retained; blocked_count remains legacy not-selectable meaning",
      "unnegotiated_mcp_tools": "prior shapes retained",
      "evidence_show_summary": "retained distinct from write receipt"
    },
    "independent_counterexample": "CX-COMPAT-01"
  },
  "counterexamples": [
    {
      "id": "CX-WR-01",
      "layer": "work_readiness",
      "title": "Context complete while readiness blocked",
      "scenario": {
        "context_completeness": {
          "complete": true,
          "context_hash": "sha256:demo-complete"
        },
        "work_readiness": {
          "ready": false,
          "missing_dependencies": [
            "AWR-EVO-000"
          ],
          "queue": "waiting"
        },
        "execution_admission": {
          "active_claims": []
        },
        "false_inference_forbidden": [
          "treat_as_admitted",
          "treat_as_completed"
        ]
      },
      "expect": {
        "work_readiness.ready": false,
        "context_completeness.complete": true,
        "must_not_promote_to": [
          "execution_admission.granted",
          "completion_validity.pass"
        ]
      }
    },
