  "premises": [
    "Reuse existing objects (work/status/claim/session/context/execution/evidence/completion); do not invent five independently advancing state machines.",
    "unknown must never default to success.",
    "readable must never imply writable.",
    "context_completeness must never imply dependencies_done / work_readiness.",
    "work_readiness must never imply execution_admission.",
    "host-reported delivery success must never imply completion_validity.",
    "New fields/views require explicit capability or protocol negotiation; keep legacy shapes for unnegotiated consumers.",
    "Missing required capability fails closed (CapabilityUnavailable / ProtocolUnsupported); do not silently degrade."
  ],
  "layers": [
    {
      "id": "work_readiness",
      "title_zh": "工作准备",
      "title_en": "Work readiness",
      "version": "evo-010-layer-work_readiness/v1",
      "reuses": [
        "status action queues (current/ready/waiting/blocked)",
        "ready / awr_work_ready eligibility",
        "work structure + dependency projection",
        "prepare readiness diagnostics"
      ],
      "sources": {
        "local_cli": {
          "classification": "shared+transformed",
          "entrypoints": [
            "status",
            "ready",
            "work show",
            "work prepare"
          ],
          "notes": "CLI refresh may update rebuildable projections; authoritative sources untouched.",
          "fields": [
            "ready",
            "queues.*",
            "missing_dependencies",
            "diagnostics"
          ],
          "freshness_basis": "source_refresh"
        },
        "shared_mcp": {
          "classification": "shared+transformed",
          "entrypoints": [
            "awr_project_status",
            "awr_work_ready",
            "awr_work_get",
            "awr_work_prepare"
          ],
          "notes": "Read-only verified snapshot; stale sources reject rather than refresh.",
          "fields": [
            "ready",
            "queues.*",
            "missing_dependencies",
            "diagnostics"
          ],
          "freshness_basis": "source_verified_readonly"
        },
        "team_pg": {
          "classification": "shared+unsupported_partial",
          "entrypoints": [
            "Team status/ready when authorized"
          ],
          "notes": "Team PostgreSQL is unique fact owner in Team mode (EVO-000).",
          "fields": [
            "coordination readiness overlays"
          ],
          "unsupported": [
            "Personal SQLite readiness as Team authority when remote missing"
          ]
        }
      },
      "can_prove": [
        "Source-declared structure and required dependencies are present or explicitly missing.",
        "Work is or is not eligible for a new claim under current projection.",
        "Navigation queues classify current/ready/waiting/blocked without authorizing execution."
      ],
      "cannot_prove": [
        "Caller holds execution admission / writable claim.",
        "Compiled context is complete.",
        "Any delivery reached a model or host consumer.",
        "Completion / acceptance is valid.",
        "Unknown dependency or source state is actually clear."
      ],
      "independent_counterexample": "CX-WR-01"
    },
    {
      "id": "execution_admission",
      "title_zh": "执行准入",
      "title_en": "Execution admission",
      "version": "evo-010-layer-execution_admission/v1",
      "reuses": [
        "session start/bind",
        "claim acquire/release",
        "expected-revision optimistic concurrency",
        "management.decision.execution_admission constant (never grants)"
      ],
      "sources": {
        "local_cli": {
          "classification": "shared",
          "entrypoints": [
            "session start",
            "work claim/progress/block/complete",
            "client bind"
          ],
          "notes": "Client bind does not claim work; claim remains an explicit domain action.",
          "fields": [
            "active_claims",
            "session_id",
            "claim.id",
            "expected_revision"
          ],
          "writable": true
        },
        "shared_mcp": {
          "classification": "shared+transformed",
          "entrypoints": [
            "awr_session_start",
            "awr_work_transition",
            "awr_client_bind"
          ],
          "notes": "Shared HTTP writes require authenticated client-bound session.",
          "fields": [
            "active_claims",
            "session",
            "claim"
          ],
          "writable": true
        },
        "team_pg": {
          "classification": "shared+transformed",
          "entrypoints": [
            "Team claim/session leases"
          ],
          "notes": "Admission facts owned by Team PG under Team entry.",
          "fields": [
            "lease/session ownership"
          ],
          "unsupported": [
            "Personal MCP as Team command dispatch"
          ]
        }
      },
      "can_prove": [
        "Whether an active claim exists for a session/agent on a work item.",
        "Whether a mutation was rejected for ClaimConflict / RevisionConflict / RuleViolation.",
        "That management classification alone does not grant admission."
      ],
      "cannot_prove": [
        "Context completeness.",
        "Dependency readiness (claimed work may still be blocked).",
        "Delivery or model receipt.",
        "Business completion validity.",
        "That unknown claim/session state is safe to treat as admitted."
      ],
      "independent_counterexample": "CX-EA-01"
    },
    {
      "id": "context_completeness",
      "title_zh": "上下文完整",
      "title_en": "Context completeness",
      "version": "evo-010-layer-context_completeness/v1",
      "reuses": [
        "context compile / awr_context_compile",
        "ContextCompleteness / completeness.complete",
        "ContextIncomplete / BudgetExceeded",
        "context hash + source version bindings"
      ],
      "sources": {
        "local_cli": {
          "classification": "shared",
          "entrypoints": [
            "context compile",
            "branch context",
            "work prepare"
          ],
          "notes": "ok=false with ContextIncomplete retains body; hard facts are not truncated.",
          "fields": [
            "completeness",
            "work_context",
            "context_hash",
            "gaps",
            "ok"
          ]
        },
        "shared_mcp": {
          "classification": "shared",
          "entrypoints": [
            "awr_context_compile",
            "awr_work_prepare"
          ],
          "notes": "continuity envelope is independent of L1 body/budget/hash.",
          "fields": [
            "completeness",
            "work_context",
            "context_hash",
            "continuity"
          ]
        },
        "team_pg": {
          "classification": "transformed+unsupported_partial",
          "entrypoints": [
            "Team context surfaces when implemented"
          ],
          "notes": "Completeness still binds declared required sources/rules/acceptance.",
          "unsupported": [
            "Substituting Team coordination blobs for required hard facts"
          ]
        }
      },
      "can_prove": [
        "Required context ingredients are present, missing, or omitted with reasons under a budget.",
        "A context hash binds specific source/runtime snapshot identities.",
        "Hard-fact budget overflow is BudgetExceeded, not silent truncation."
      ],
      "cannot_prove": [
        "Dependencies are finished (context may be complete while work is blocked).",
        "Caller has writable execution admission.",
        "Delivered bytes were received/consumed by a model.",
        "Completion evidence satisfies acceptance.",
        "Unknown completeness fields default to complete=true."
      ],
      "independent_counterexample": "CX-CC-01"
    },
    {
      "id": "delivery_observation",
      "title_zh": "投递",
      "title_en": "Delivery observation",
      "version": "evo-010-layer-delivery_observation/v1",
      "reuses": [
        "context acknowledge / consumed-hash",
        "client progress / hooks",
        "execution register/report (ExternalExecutionReport)",
        "waiting queues and non-terminal executions",
        "host-reported phases"
      ],
      "sources": {
        "local_cli": {
          "classification": "shared",
          "entrypoints": [
            "client progress",
            "client hook",
            "execution report",
            "execution report-status",
            "workflow ack"
          ],
          "notes": "Host-reported succeeded still leaves AWR observation unknown/unverified.",
          "fields": [
            "phase",
            "origin",
            "request_key",
            "consumed_hash",
            "detail_references"
          ]
        },
        "shared_mcp": {
          "classification": "shared+transformed",
          "entrypoints": [
            "awr_client_progress",
            "awr_execution_report",
            "continuity waits"
          ],
          "notes": "Transport receipt is not model comprehension.",
          "fields": [
            "phase",
            "continuity",
            "waits"
          ]
        },
        "team_pg": {
          "classification": "shared+transformed",
          "entrypoints": [
            "Team execution/wait records"
          ],
          "notes": "Recorded waits/unknown outcomes only; no invented live probe.",
          "unsupported": [
            "Live process probes as delivery proof"
          ]
        }
      },
      "can_prove": [
        "A host attested delivery/ack/progress/report with durable request identity.",
        "Whether a retained report receipt exists for a request_key.",
        "That interrupted/unknown delivery remains unknown until inspected."
      ],
      "cannot_prove": [
        "Model comprehension or correct tool use.",
        "Work readiness or dependency completion.",
        "Execution admission.",
        "Acceptance/completion validity.",
        "Transport timeout implies source_write_performed=false or success."
      ],
      "independent_counterexample": "CX-DO-01"
    },
    {
      "id": "completion_validity",
      "title_zh": "完成有效性",
      "title_en": "Completion validity",
      "version": "evo-010-layer-completion_validity/v1",
      "reuses": [
        "work complete / awr_work_transition action=complete",
        "evidence add + validation_basis",
        "ordinary_completion vs verified_completed",
        "intake inspect / history verification codes",
        "CompletionReport runtime-v1"
      ],
      "sources": {
        "local_cli": {
          "classification": "shared",
          "entrypoints": [
            "work complete",
            "evidence add",
            "intake inspect",
            "host confirm_ordinary"
          ],
          "notes": "Evidence record success is not command execution or business acceptance.",
          "fields": [
            "completion",
            "evidence",
            "validation_basis",
            "history.verification_*",
            "ordinary_completion"
          ]
        },
        "shared_mcp": {
          "classification": "shared",
          "entrypoints": [
            "awr_work_transition(complete)",
            "awr_evidence_record"
          ],
          "notes": "Same domain gates as CLI.",
          "fields": [
            "completion",
            "evidence",
            "validation_basis"
          ]
        },
        "team_pg": {
          "classification": "shared+transformed",
          "entrypoints": [
            "Team completion/evidence when authorized"
          ],
          "notes": "Preserve historical denominators (EVO-000/002).",
          "unsupported": [
            "GitHub merge as completion",
            "Rewriting V1/Team denominators"
          ]
        }
      },
      "can_prove": [
        "Whether domain completion gates accepted a bound evidence set for a work item.",
        "Distinction among user_confirmed / business_checked / verified_completed under policy.",
        "That unknown/missing evidence is not a pass."
      ],
      "cannot_prove": [
        "That context delivery occurred.",
        "That readiness queues alone authorize completion.",
        "That host-reported execution succeeded implies acceptance.",
        "That historical warnings certify unrelated current work.",
        "That absent verification equals verified_completed."
      ],
      "independent_counterexample": "CX-CV-01"
    }
  ],
